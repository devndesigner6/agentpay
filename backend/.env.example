# Start on Testnet. Switch every related value together when launching on Mainnet.
PORT=3000
NODE_ENV=development
INTERNAL_BASE_URL=http://127.0.0.1:3000
# Comma-separated origins allowed to call the API. Leave blank for local development.
FRONTEND_URL=http://localhost:5173

# Algorand: testnet uses USDC ASA 10458941; mainnet uses USDC ASA 31566704.
ALGORAND_NETWORK=testnet
ALGORAND_ALGOD_URL=https://testnet-api.algonode.cloud
ALGORAND_ALGOD_TOKEN=
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
USDC_ASSET_ID=10458941

# GoPlausible hosted x402 facilitator and the wallet paid by AgentPay clients.
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
X402_PAY_TO_ADDRESS=REPLACE_WITH_USDC_OPTED_IN_ALGORAND_ADDRESS
ROUTER_FEE=0.03

# Router wallet: mnemonic for the account that pays the selected provider.
# Keep this only in a secret manager; never commit a real mnemonic.
ROUTER_PRIVATE_KEY=REPLACE_WITH_ROUTER_MNEMONIC

# Provider recipient wallets. For a composite deployment, use separate provider
# accounts only when they are genuinely separate services; each must be USDC opted-in.
CHEAP_PROVIDER_PRICE=0.005
CHEAP_PAY_TO_ADDRESS=REPLACE_WITH_CHEAP_PROVIDER_ADDRESS
CHEAP_PROVIDER_URL=
BALANCED_PROVIDER_PRICE=0.01
BALANCED_PAY_TO_ADDRESS=REPLACE_WITH_BALANCED_PROVIDER_ADDRESS
BALANCED_PROVIDER_URL=
PREMIUM_PROVIDER_PRICE=0.02
PREMIUM_PAY_TO_ADDRESS=REPLACE_WITH_PREMIUM_PROVIDER_ADDRESS
PREMIUM_PROVIDER_URL=

# Optional: actual model output. Without this key the provider adapter returns a clearly labelled demo response.
OPENROUTER_API_KEY=

# Demo agent client (never commit an agent mnemonic).
AGENTPAY_URL=http://127.0.0.1:3000/api/generate
AGENT_MNEMONIC=
AGENT_PREFERENCE=cheapest
